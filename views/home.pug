doctype html
html
  head
    title= `${title}`
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Song Catalog
    a(href="/update-cobj") Add a Song

    if error
      p.error= error

    if songs && songs.length
      table
        thead
          tr
            th Title
            th Composers
            th CCLI #
            th Year
            th Publishers
            th Rights Assoc.
        tbody
          each song in songs
            tr
              td= song.properties.title
              td= song.properties.composers
              td= song.properties.ccli_number
              td= song.properties.year
              td= song.properties.publishers
              td= song.properties.performing_rights_association
    else
      p No songs found.